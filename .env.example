# Loopback development only.
SERVER_ADDRESS=127.0.0.1
APP_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
OIDC_ISSUER=http://localhost:8080/realms/complylet
OIDC_CLIENT_SECRET=local-oidc
DB_URL=jdbc:postgresql://localhost:5432/complylet
DB_USER=complylet_runtime
DB_PASSWORD=local-runtime
FLYWAY_ENABLED=true
DB_MIGRATION_USER=complylet_migration
DB_MIGRATION_PASSWORD=local-migration
OPENAPI_ENABLED=true

# Outbound email settings for a separately deployed Keycloak, applied by the identity operator.
# EMAIL_FROM=accounts@accounts.example.com
