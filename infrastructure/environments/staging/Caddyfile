{
	admin off
	auto_https off
	persist_config off
	servers {
		protocols h1 h2
	}
}

https://{$STAGING_HOST}:8443 {
	tls /run/secrets/tls_certificate /run/secrets/tls_private_key
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options DENY
		-Server
		-X-Powered-By
	}

	@backend path /api/v1 /api/v1/* /oauth2/authorization/complylet /login/oauth2/code/complylet /logout
	handle @backend {
		reverse_proxy api:8081
	}

	@private path /actuator /actuator/* /v3 /v3/* /swagger-ui /swagger-ui/*
	handle @private {
		respond 404
	}

	handle {
		root * /srv
		header Content-Security-Policy "default-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'"
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle_errors {
		header {
			-Server
			-X-Powered-By
		}
		respond "" {err.status_code}
	}
}
