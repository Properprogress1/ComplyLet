# Reserved validation values. Use a separate, ignored file for real staging inputs.
STAGING_API_IMAGE=registry.example.invalid/complylet-api:validation
STAGING_WEB_IMAGE=registry.example.invalid/complylet-web:validation
STAGING_HOST=staging.example.invalid
STAGING_APP_ORIGIN=https://staging.example.invalid:8443
STAGING_OIDC_ISSUER=https://identity.example.invalid/realms/complylet-staging
STAGING_OIDC_CLIENT_ID=complylet-staging
STAGING_DB_URL=jdbc:postgresql://postgres.example.invalid:5432/complylet?sslmode=verify-full
STAGING_DB_USER=complylet_runtime
STAGING_DB_PASSWORD_FILE=/run/complylet-validation/db-password
STAGING_OIDC_CLIENT_SECRET_FILE=/run/complylet-validation/oidc-client-secret
STAGING_TLS_CERTIFICATE_FILE=/run/complylet-validation/tls-chain.pem
STAGING_TLS_PRIVATE_KEY_FILE=/run/complylet-validation/tls-key.pem
